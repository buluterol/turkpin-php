{
    "name": "buluterol/turkpin",
    "description": "PHP client for the Turkpin dealer (bayi) API with Laravel and Symfony integration: e-pin games, products, orders and balance.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "turkpin",
        "epin",
        "e-pin",
        "api",
        "sdk",
        "laravel",
        "symfony"
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "orchestra/testbench": "^8.0|^9.0",
        "symfony/http-kernel": "^6.4|^7.0",
        "symfony/dependency-injection": "^6.4|^7.0",
        "symfony/config": "^6.4|^7.0"
    },
    "autoload": {
        "psr-4": {
            "Turkpin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Turkpin\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests"
    },
    "suggest": {
        "laravel/framework": "Laravel service provider and facade (Turkpin\\Laravel)",
        "symfony/http-kernel": "Symfony bundle (Turkpin\\Symfony\\TurkpinBundle)"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Turkpin\\Laravel\\TurkpinServiceProvider"
            ],
            "aliases": {
                "Turkpin": "Turkpin\\Laravel\\Facades\\Turkpin"
            }
        }
    },
    "config": {
        "allow-plugins": {}
    }
}
