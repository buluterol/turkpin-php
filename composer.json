{
    "name": "buluterol/turkpin",
    "description": "PHP client for the Turkpin dealer (bayi) API: e-pin games, products, orders and balance.",
    "type": "library",
    "license": "MIT",
    "keywords": ["turkpin", "epin", "e-pin", "api", "sdk"],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "Turkpin\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Turkpin\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit tests"
    }
}
